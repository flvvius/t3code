# Copy to .env and fill in. Nothing here is a secret: keys and database passwords are files
# under secrets/, created by gen-keys.sh.

# Public HTTPS origin clients use to reach the relay, served by Caddy.
RELAY_PUBLIC_ORIGIN=https://relay.example.com
# Host name Caddy serves and obtains a certificate for.
RELAY_DOMAIN=relay.example.com

# Your OpenID Connect issuer, exactly as its discovery document reports it
# (including any path prefix, without a trailing slash unless the issuer has one).
OIDC_ISSUER=https://sso.example.com/realms/t3
# The OAuth client id of the T3 Code apps. Clients send their ID token, whose `aud` is that id.
OIDC_AUDIENCE=t3-code

# Optional: carry environments with no public address through the relay itself, at
# RELAY_PUBLIC_ORIGIN/env/<key>/. No DNS or certificate beyond the relay's own.
# RELAY_CHANNELS=true

# Optional: environments you expose yourself (no tunnel). "off" (the default) refuses them,
# "public" brokers internet-reachable HTTPS addresses, "private" also LAN/Tailscale addresses.
# The relay connects to whatever address a linking user declares, so leave this off unless
# you need it.
# RELAY_MANUAL_ENDPOINTS=off

# Optional: host ports, when 80 and 443 are taken.
# HTTP_PORT=80
# HTTPS_PORT=443
